NAME = philo

SRCS = checker.c main.c init_all.c eatforks.c prints.c monit.c utils.c monitorutils.c

OUT = $(SRCS:.c=.o)

CC = gcc

CFLAGS = -Wall -Wextra -Werror -pthread

.c.o:
	${CC} ${CFLAGS} -g -c  $< -o ${<:.c=.o}

