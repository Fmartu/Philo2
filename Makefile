all:	$(NAME)

clean:
		rm -f $(OUT)

fclean: clean
		rm -f $(NAME)
		@echo "\n\033[33m🍜 time 🍜 to 🍜\033[31m (f)clean 🍜\033[33m up 🍜\033[0m\n"

re: 	fclean all

.PHONY: all clean fclean re
